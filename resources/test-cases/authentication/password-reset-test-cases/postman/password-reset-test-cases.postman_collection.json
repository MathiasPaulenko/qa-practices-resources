{
  "info": {
    "name": "Password Reset Test Cases",
    "description": "Postman collection covering the 16 password reset test cases from qapractices.com. Point the `base_url` variable at your staging API before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://demo-api.qapractices.test",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "qa-tester@qapractices.test",
      "type": "string"
    },
    {
      "key": "unknown_email",
      "value": "unknown@qapractices.test",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "reset-token-abc123xyz",
      "type": "string"
    },
    {
      "key": "expired_token",
      "value": "expired-token-xyz789",
      "type": "string"
    },
    {
      "key": "new_password",
      "value": "NewSecurePass456@",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "TC-001: Reset request with valid email",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-request",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{test_email}}\"}"
        }
      },
      "test": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
    },
    {
      "name": "TC-006: Reset request with unregistered email",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-request",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{unknown_email}}\"}"
        }
      },
      "test": ["pm.test('Status is 200 (no enumeration)', () => pm.response.to.have.status(200));"]
    },
    {
      "name": "TC-007: Reset request with invalid email format",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-request",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"not-an-email\"}"
        }
      },
      "test": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
    },
    {
      "name": "TC-002: Reset confirm with valid token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-confirm",
        "body": {
          "mode": "raw",
          "raw": "{\"token\": \"{{reset_token}}\", \"newPassword\": \"{{new_password}}\"}"
        }
      },
      "test": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
    },
    {
      "name": "TC-003: Reset confirm with weak password",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-confirm",
        "body": {
          "mode": "raw",
          "raw": "{\"token\": \"{{reset_token}}\", \"newPassword\": \"weak\"}"
        }
      },
      "test": ["pm.test('Status is 400 (policy)', () => pm.response.to.have.status(400));"]
    },
    {
      "name": "TC-008: Reset confirm with expired token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-confirm",
        "body": {
          "mode": "raw",
          "raw": "{\"token\": \"{{expired_token}}\", \"newPassword\": \"{{new_password}}\"}"
        }
      },
      "test": ["pm.test('Status is 400 (expired)', () => pm.response.to.have.status(400));"]
    },
    {
      "name": "TC-009: Reset confirm with reused token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-confirm",
        "body": {
          "mode": "raw",
          "raw": "{\"token\": \"{{reset_token}}\", \"newPassword\": \"AnotherPass789#\"}"
        }
      },
      "test": ["pm.test('Status is 400 (already used)', () => pm.response.to.have.status(400));"]
    },
    {
      "name": "TC-011: Rate limit burst (6 rapid requests)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('6th request returns 429', () => {",
              "  pm.response.to.have.status(429);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/reset-request",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{test_email}}\"}"
        }
      }
    }
  ]
}
