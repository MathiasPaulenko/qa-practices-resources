<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config.
  Trusts user-installed CAs so mitmproxy / OWASP ZAP can intercept traffic.

  Apply it only to debug builds:
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        ... >

  If this file (or "user" under trust-anchors) reaches a release build,
  certificate pinning stops protecting the connection.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
