{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/"],
      "settings": {
        "onlyCategories": ["accessibility"],
        "chromeFlags": "--headless --no-sandbox"
      },
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:accessibility.*": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
