<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestNG Guide Suite" parallel="methods" thread-count="4">
  <test name="Smoke Tests">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="com.qapractices.CalculatorTest"/>
    </classes>
  </test>
  <test name="Regression Tests">
    <groups>
      <run>
        <include name="regression"/>
      </run>
    </groups>
    <classes>
      <class name="com.qapractices.CalculatorTest"/>
      <class name="com.qapractices.LoginTest"/>
    </classes>
  </test>
</suite>
