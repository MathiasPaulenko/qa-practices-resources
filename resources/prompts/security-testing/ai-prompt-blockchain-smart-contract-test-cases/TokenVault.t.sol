pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/// @notice Minimal ETH vault used to illustrate the test cases generated by
/// the prompt. Shares are minted 1:1 on the first deposit.
contract TokenVault is ReentrancyGuard, Ownable, Pausable {
    mapping(address => uint256) public shares;
    uint256 public totalShares;
    uint256 public feeBps;
    uint256 public constant MAX_FEE_BPS = 500;

    event Deposit(address indexed caller, uint256 amount);
    event Withdraw(address indexed caller, uint256 amount);
    event FeeUpdated(uint256 newFeeBps);

    error ZeroAmount();
    error InsufficientShares();
    error FeeTooHigh();
    error TransferFailed();

    constructor(address owner_) Ownable(owner_) {}

    function deposit() external payable nonReentrant whenNotPaused {
        if (msg.value == 0) revert ZeroAmount();
        uint256 minted = totalShares == 0
            ? msg.value
            : (msg.value * totalShares) / (address(this).balance - msg.value);
        shares[msg.sender] += minted;
        totalShares += minted;
        emit Deposit(msg.sender, msg.value);
    }

    function withdraw(uint256 shareAmount) external nonReentrant {
        if (shareAmount == 0) revert ZeroAmount();
        if (shares[msg.sender] < shareAmount) revert InsufficientShares();
        uint256 amount = (shareAmount * address(this).balance) / totalShares;
        shares[msg.sender] -= shareAmount;
        totalShares -= shareAmount;
        (bool ok,) = msg.sender.call{value: amount}("");
        if (!ok) revert TransferFailed();
        emit Withdraw(msg.sender, amount);
    }

    function setFee(uint256 newFeeBps) external onlyOwner {
        if (newFeeBps > MAX_FEE_BPS) revert FeeTooHigh();
        feeBps = newFeeBps;
        emit FeeUpdated(newFeeBps);
    }

    function pause() external onlyOwner {
        _pause();
    }
}

/// @notice Helper contract that tries to reenter the vault during withdraw.
/// Behind nonReentrant (and checks-effects-interactions) the inner call must
/// revert and the attacker ends up with exactly what it deposited.
contract ReentrantAttacker {
    TokenVault public vault;
    bool public reentrySucceeded;

    constructor(TokenVault vault_) {
        vault = vault_;
    }

    function attack() external payable {
        vault.deposit{value: msg.value}();
        vault.withdraw(vault.shares(address(this)));
    }

    receive() external payable {
        // Reenter via deposit: nonReentrant on vault makes this revert.
        try vault.deposit{value: 0.1 ether}() {
            reentrySucceeded = true;
        } catch {
            reentrySucceeded = false;
        }
    }
}

contract TokenVaultTest is Test {
    TokenVault vault;
    address owner = makeAddr("owner");
    address alice = makeAddr("alice");

    function setUp() public {
        vault = new TokenVault(owner);
        vm.deal(alice, 100 ether);
    }

    // TC-01 — deposit happy path
    function test_Deposit_MintsSharesOnValidDeposit() public {
        vm.prank(alice);
        vm.expectEmit(true, false, false, true);
        emit TokenVault.Deposit(alice, 50 ether);
        vault.deposit{value: 50 ether}();

        assertEq(vault.shares(alice), 50 ether);
        assertEq(vault.totalShares(), 50 ether);
        assertEq(alice.balance, 50 ether);
    }

    // TC-02 — boundary: zero deposit reverts
    function test_Deposit_RevertsOnZeroAmount() public {
        vm.prank(alice);
        vm.expectRevert(TokenVault.ZeroAmount.selector);
        vault.deposit{value: 0}();
    }

    // TC-03 — withdraw more than balance
    function test_Withdraw_RevertsWhenSharesInsufficient() public {
        vm.startPrank(alice);
        vault.deposit{value: 10 ether}();
        vm.expectRevert(TokenVault.InsufficientShares.selector);
        vault.withdraw(11 ether);
        vm.stopPrank();
    }

    // TC-04 — reentrancy on withdraw (SWC-107)
    function test_Withdraw_ReentrancyReverts() public {
        ReentrantAttacker attacker = new ReentrantAttacker(vault);
        vm.deal(address(attacker), 100.1 ether);

        attacker.attack{value: 100 ether}();

        assertFalse(attacker.reentrySucceeded());
        assertEq(address(attacker).balance, 100.1 ether);
    }

    // TC-05 — access control: setFee rejects a non-owner
    function test_SetFee_RevertsWhenCallerIsNotOwner() public {
        vm.prank(alice);
        vm.expectRevert(
            abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice)
        );
        vault.setFee(100);
    }

    // TC-06 — paused state blocks deposits
    function test_Deposit_RevertsWhenPaused() public {
        vm.prank(owner);
        vault.pause();

        vm.prank(alice);
        vm.expectRevert(Pausable.EnforcedPause.selector);
        vault.deposit{value: 1 ether}();
    }
}
