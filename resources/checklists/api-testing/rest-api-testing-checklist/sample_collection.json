{
  "info": {
    "name": "REST API HTTP Contract Smoke",
    "description": "Newman-compatible collection skeleton: one happy-path, one 401, one 404 per route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET resource - happy path",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/users/1"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
            "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
            "pm.test('ETag or Last-Modified present', () => pm.expect(pm.response.headers.has('ETag') || pm.response.headers.has('Last-Modified')).to.be.true);"
          ]
        }
      }]
    },
    {
      "name": "GET resource - missing token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/users/1"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('rejects without credentials', () => pm.expect(pm.response.code).to.eql(401));"
          ]
        }
      }]
    },
    {
      "name": "GET resource - nonexistent id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/users/00000000-0000-0000-0000-000000000000"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('404 for missing resource', () => pm.expect(pm.response.code).to.eql(404));",
            "pm.test('error body is structured', () => { const b = pm.response.json(); pm.expect(b).to.have.property('code').or.property('message'); });"
          ]
        }
      }]
    }
  ]
}
