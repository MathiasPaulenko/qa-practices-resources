{
  "policies": [
    {
      "name": "pii_filter",
      "type": "regex",
      "patterns": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"
      ],
      "action": "block"
    },
    {
      "name": "injection_filter",
      "type": "keyword",
      "patterns": [
        "ignore previous instructions",
        "system prompt",
        "DAN mode",
        "developer mode"
      ],
      "action": "block"
    },
    {
      "name": "toxicity_filter",
      "type": "classifier",
      "threshold": 0.85,
      "action": "block"
    }
  ]
}
