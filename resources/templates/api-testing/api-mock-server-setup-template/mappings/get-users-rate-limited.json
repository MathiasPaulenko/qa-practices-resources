{
  "request": {
    "method": "GET",
    "urlPath": "/users",
    "headers": {
      "X-Simulate-Latency": {
        "equalTo": "5000"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMs": 5000,
    "jsonBody": [
      {
        "id": 1,
        "name": "John Doe",
        "email": "john@example.com"
      }
    ]
  }
}
